{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/guard-git-add-all.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/scripts/validate-plugin.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/on-commit-style.sh"
          }
        ]
      }
    ]
  }
}
